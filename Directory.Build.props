<Project>

  <PropertyGroup>
    <!-- 唯一版本号：程序集版本、安装包清单、CM3STATUS 都从这里来。 -->
    <Version>0.5.4</Version>
    <AssemblyVersion>0.5.4.0</AssemblyVersion>
    <FileVersion>0.5.4.0</FileVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- 许可与作者元数据：MIT（见 LICENSE）。 -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Oreak-jack</Authors>
    <Product>CadMath03 (AutoCAD Inline Math)</Product>
    <RepositoryUrl>https://github.com/Oreak-jack/autocad-inline-math</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- AutoCAD 托管引用目录；构建适配器时需要，例如 -p:AcadDir="D:\AutoCAD 2026" -->
    <AcadDir Condition="'$(AcadDir)' == ''">$(ACAD_REFERENCE_DIR)</AcadDir>

    <!--
      官方 NuGet 引用版本（只编译、不复制）。取法见 docs/VERSION-MATRIX.md：
      **编译锚取 band 内最旧的 SDK**，这样编出来的程序集只依赖旧版本就有的 API，
      在更新的宿主上运行时由 AutoCAD 解析成它自己那一份，于是"一个 band 只编一份、只测最新一个版本"。
        AcadSdkVersion        .NET 8 宿主：25.0.1 = AutoCAD 2025；25.1.0 = AutoCAD 2026。
        AcadLegacySdkVersion  .NET Framework 宿主：24.0.0 = AutoCAD 2021（覆盖 2021–2024）；23.1.0 = AutoCAD 2020。
      改这两个属性即可换编译基准，不必逐个项目改 csproj。
    -->
    <AcadSdkVersion Condition="'$(AcadSdkVersion)' == ''">25.1.0</AcadSdkVersion>
    <!-- AutoCAD.NET.Model / .Core 的版本号与 AutoCAD.NET 不一定同步（2025 只有 25.0.0/25.0.2，没有 25.0.1）。 -->
    <AcadSdkModelVersion Condition="'$(AcadSdkModelVersion)' == ''">$(AcadSdkVersion)</AcadSdkModelVersion>
    <AcadLegacySdkVersion Condition="'$(AcadLegacySdkVersion)' == ''">24.0.0</AcadLegacySdkVersion>
  </PropertyGroup>

</Project>
