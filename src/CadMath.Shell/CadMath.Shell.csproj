<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 一套代码，两代 CLR：net8 给 AutoCAD 2025/2026，net48 给 2024 及更早。 -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <RootNamespace>CadMath.Shell</RootNamespace>
    <AssemblyName>CadMath03</AssemblyName>
    <Description>插件宿主：生命周期、命令、配置、日志、适配器选择。不实现任何 CAD API 细节。</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadMath.Core\CadMath.Core.csproj" />
    <ProjectReference Include="..\CadMath.Abstractions\CadMath.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\adapters\adapters.json" Link="adapters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- AutoCAD 2025/2026：官方 NuGet，只编译不复制。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="$(AcadSdkVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="$(AcadSdkVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="$(AcadSdkVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- AutoCAD 2021–2024 / 2020：官方 NuGet 的 .NET Framework 程序集，用 -p:AcadLegacySdkVersion 选基准。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="$(AcadLegacySdkVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="$(AcadLegacySdkVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="$(AcadLegacySdkVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>