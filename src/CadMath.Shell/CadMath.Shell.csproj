<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CadMath.Shell</RootNamespace>
    <AssemblyName>CadMath03</AssemblyName>
    <Description>插件宿主：生命周期、命令、配置、日志、适配器选择。不实现任何 CAD API 细节。</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadMath.Core\CadMath.Core.csproj" />
    <ProjectReference Include="..\CadMath.Abstractions\CadMath.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="acmgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\adapters\adapters.json" Link="adapters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="RequireAcadDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(AcadDir)' == ''">
    <Error Text="未设置 AutoCAD 托管引用目录。请构建时传 -p:AcadDir=&quot;D:\AutoCAD 2026&quot;，或设置环境变量 ACAD_REFERENCE_DIR。" />
  </Target>

</Project>
