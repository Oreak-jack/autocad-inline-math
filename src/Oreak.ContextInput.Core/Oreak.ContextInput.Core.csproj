<Project Sdk="Microsoft.NET.Sdk">

  <!--
    语境切换（输入法跟随文本框）的纯策略层：不依赖 AutoCAD、不依赖 Windows、不碰键盘。
    来自 Oreak ContextInput 0.1.8，独立于 CadMath 维护：它坏了不影响算式插件，反之亦然。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 独立版本线：产品版本随 CadMath 发行包走，但程序集版本仍是这个模块自己的 0.1.8 血统。 -->
    <Version>0.1.8</Version>
    <AssemblyVersion>0.1.8.0</AssemblyVersion>
    <FileVersion>0.1.8.0</FileVersion>
    <Product>Oreak ContextInput</Product>
    <Description>Context switching policy: Chinese while editing text, English everywhere else.</Description>
  </PropertyGroup>

</Project>
